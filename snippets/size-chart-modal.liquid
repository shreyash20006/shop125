<div id="size-chart-modal" class="modal" data-size-chart-modal aria-hidden="true">
  <div class="modal__overlay" data-size-chart-close></div>
  <div class="modal__panel" role="dialog" aria-modal="true" aria-label="Size chart">
    <div class="modal__header">
      <h2 class="modal__title">Size Chart</h2>
      <button type="button" data-size-chart-close aria-label="{{ 'general.close' | t }}">{% render 'icon-close' %}</button>
    </div>
    <div class="modal__body rte">
      {%- if chart_image != blank -%}
        {{ chart_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: 'Size chart' }}
      {%- elsif chart_content != blank -%}
        {{ chart_content }}
      {%- else -%}
        <table class="size-chart-table">
          <thead><tr><th>Size</th><th>Chest (in)</th><th>Length (in)</th><th>Shoulder (in)</th></tr></thead>
          <tbody>
            <tr><td>S</td><td>38-40</td><td>27</td><td>17</td></tr>
            <tr><td>M</td><td>40-42</td><td>28</td><td>18</td></tr>
            <tr><td>L</td><td>42-44</td><td>29</td><td>19</td></tr>
            <tr><td>XL</td><td>44-46</td><td>30</td><td>20</td></tr>
            <tr><td>XXL</td><td>46-48</td><td>31</td><td>21</td></tr>
          </tbody>
        </table>
        <p style="margin-top:1rem;color:var(--color-text-muted);font-size:0.85rem;">Measurements are approximate. For oversized fits, size up.</p>
      {%- endif -%}
    </div>
  </div>
</div>
