{%- liquid
  assign social_links_array = ''
  if settings.social_instagram != blank
    assign social_links_array = social_links_array | append: settings.social_instagram | append: '||'
  endif
  if settings.social_facebook != blank
    assign social_links_array = social_links_array | append: settings.social_facebook | append: '||'
  endif
  if settings.social_youtube != blank
    assign social_links_array = social_links_array | append: settings.social_youtube | append: '||'
  endif
  if settings.social_twitter != blank
    assign social_links_array = social_links_array | append: settings.social_twitter | append: '||'
  endif
  assign social_links_list = social_links_array | split: '||'
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    {%- if settings.logo != blank -%}
    "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {%- endif -%}
    "description": {{ settings.brand_tagline | json }}
    {%- if social_links_array != blank -%}
    ,"sameAs": [
      {%- for link in social_links_list -%}
        {%- if link != blank -%}
          {{ link | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    ]
    {%- endif -%}
  }
</script>

{%- if template.name == 'product' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | truncate: 500 | json }},
      "image": [
        {%- for image in product.images -%}
          {{ image | image_url: width: 1200 | prepend: "https:" | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
      "brand": {
        "@type": "Brand",
        "name": {{ shop.name | json }}
      },
      "offers": {
        "@type": "Offer",
        "url": {{ shop.url | append: product.url | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }},
        "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"
      }
    }
  </script>
{%- endif -%}

{%- if template.name == 'collection' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ collection.title | json }},
      "description": {{ collection.description | strip_html | truncate: 500 | json }},
      "url": {{ shop.url | append: collection.url | json }}
    }
  </script>
{%- endif -%}
