[
  {
    "name": "theme_info",
    "theme_name": "Escape Clothing",
    "theme_version": "2.0.0",
    "theme_author": "Escape Clothing",
    "theme_documentation_url": "https://github.com",
    "theme_support_url": "https://github.com"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 140
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Tagline",
        "default": "Escape The Ordinary"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#0a0a0a"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface",
        "default": "#141414"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Muted text",
        "default": "#a3a3a3"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border",
        "default": "#2a2a2a"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "helvetica_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "helvetica_n4"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_twitter",
        "label": "X (Twitter) URL"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Enable cart note",
        "default": false
      }
    ]
  },
  {
    "name": "Analytics",
    "settings": [
      { "type": "text", "id": "google_analytics_id", "label": "Google Analytics ID (G-XXXXXXXX)", "info": "Paste your GA4 measurement ID" },
      { "type": "text", "id": "facebook_pixel_id", "label": "Facebook Pixel ID", "info": "Paste your Meta Pixel ID" }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  }
]
