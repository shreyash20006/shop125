<div class="collection-page">
  <div class="page-width">
    <div class="section-header">
      <h1 class="section-header__title">{{ 'collections.title' | t }}</h1>
    </div>

    <div class="category-grid">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          <a href="{{ collection.url }}" class="category-card">
            {%- if collection.featured_image -%}
              {{
                collection.featured_image
                | image_url: width: 800
                | image_tag: loading: 'lazy', class: 'category-card__image', widths: '400,600,800', sizes: '(min-width: 750px) 25vw, 50vw'
              }}
            {%- else -%}
              {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'category-card__image' }}
            {%- endif -%}
            <div class="category-card__overlay">
              <div>
                <p class="category-card__title">{{ collection.title }}</p>
                <p class="category-card__count">{{ collection.products_count }} products</p>
              </div>
            </div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "class": "list-collections-section",
  "settings": []
}
{% endschema %}
