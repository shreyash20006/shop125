<section class="trust-section section-reveal">
  <div class="page-width">
    <div class="section-header">
      <p class="section-label">{{ section.settings.label | default: 'Our Promise' }}</p>
      <h2 class="section-title">{{ section.settings.title | default: 'Why Choose Escape Clothing 👣' }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="trust-grid">
      {%- for block in section.blocks -%}
        <div class="trust-card" {{ block.shopify_attributes }}>
          <div class="trust-card__icon-wrap">
            <span class="trust-card__icon">{{ block.settings.icon | default: '★' }}</span>
          </div>
          <h3 class="trust-card__title">{{ block.settings.title }}</h3>
          <p class="trust-card__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    <div class="trust-payments">
      <p class="trust-payments__label">Accepted Payments</p>
      {% render 'payment-icons' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why choose us",
  "tag": "section",
  "class": "why-choose-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "label", "label": "Section label", "default": "Our Promise" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Why Choose Escape Clothing" },
    { "type": "text", "id": "subtitle", "label": "Subheading", "default": "Premium streetwear, built for India" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "★" },
        { "type": "text", "id": "title", "label": "Title", "default": "Premium Quality" },
        { "type": "text", "id": "text", "label": "Description", "default": "Streetwear-grade fabrics and premium fits." }
      ]
    }
  ],
  "presets": [{
    "name": "Why choose us",
    "blocks": [
      { "type": "feature", "settings": { "icon": "🎯", "title": "Premium Quality", "text": "Streetwear-grade fabrics, premium stitching, and fits that actually look good IRL." } },
      { "type": "feature", "settings": { "icon": "🚚", "title": "Fast Shipping", "text": "Pan-India delivery in 3–7 business days. Free shipping above ₹999." } },
      { "type": "feature", "settings": { "icon": "🔒", "title": "Secure Payments", "text": "Cashfree protected checkout with UPI, cards, net banking & Cash on Delivery." } },
      { "type": "feature", "settings": { "icon": "↩", "title": "Easy Returns", "text": "7-day hassle-free returns on all unused, unwashed items." } }
    ]
  }]
}
{% endschema %}
