<div class="password-page__wrapper" style="min-height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 2rem;">
  <div>
    <h1 style="font-size: 2rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem;">
      Escape Clothing 👣
    </h1>
    <p style="color: var(--color-text-muted); margin-bottom: 2rem;">{{ settings.brand_tagline }}</p>

    {%- if shop.password_message != blank -%}
      <div class="rte" style="margin-bottom: 2rem;">{{ shop.password_message }}</div>
    {%- endif -%}

    {% form 'storefront_password' %}
      {%- if form.errors -%}
        <p style="color: #ff4757; margin-bottom: 1rem;">{{ form.errors.messages.form }}</p>
      {%- endif -%}
      <div style="display: flex; gap: 0; max-width: 400px; margin: 0 auto;">
        <input
          type="password"
          name="password"
          placeholder="Enter store password"
          style="flex: 1; padding: 1rem; background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text);"
        >
        <button type="submit" class="btn btn--primary">Enter</button>
      </div>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "main-password-section",
  "settings": []
}
{% endschema %}
