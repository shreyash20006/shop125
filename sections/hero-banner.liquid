<section class="hero" data-hero>
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'hero__video' }}
    {%- elsif section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: loading: 'eager', fetchpriority: 'high', class: 'hero__bg-image', sizes: '100vw', widths: '750,1100,1500,2000,2400'
      }}
    {%- else -%}
      <div class="hero__placeholder-bg"></div>
    {%- endif -%}
    <div class="hero__overlay"></div>
    <div class="hero__grain"></div>
  </div>

  <div class="hero__content page-width">
    <div class="hero__text-block">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- else -%}
        <p class="hero__eyebrow">New Season · 2026</p>
      {%- endif -%}

      <h1 class="hero__heading">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          ESCAPE<br>THE<br>ORDINARY
        {%- endif -%}
      </h1>

      <p class="hero__sub">
        {%- if section.settings.subheading != blank -%}
          {{ section.settings.subheading }}
        {%- else -%}
          Premium Streetwear for Every Drop
        {%- endif -%}
      </p>

      <div class="hero__actions">
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="hero__btn hero__btn--primary">
          {{ section.settings.button_label | default: 'Shop Now' }}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 | default: '#' }}" class="hero__btn hero__btn--ghost">
            {{ section.settings.button_label_2 }}
          </a>
        {%- else -%}
          <a href="{{ routes.collections_url }}" class="hero__btn hero__btn--ghost">Explore Collections</a>
        {%- endif -%}
      </div>
    </div>

    <div class="hero__scroll-hint" aria-hidden="true">
      <div class="hero__scroll-line"></div>
      <span>Scroll</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "New Season · 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ESCAPE THE ORDINARY"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium Streetwear for Every Drop"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Explore Collections"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
