{%- liquid
  assign has_blocks = false
  if section.blocks.size > 0
    assign has_blocks = true
  endif
  assign show_bar = false
  if has_blocks or section.settings.text != blank
    assign show_bar = true
  endif
-%}

{%- if show_bar -%}
  <div
    class="announcement-bar announcement-bar--marquee"
    role="region"
    aria-label="Announcement"
    style="--marquee-speed: {{ section.settings.speed }}s;"
    {% if section.settings.pause_on_hover %}data-marquee-pause{% endif %}
  >
    <div class="announcement-bar__track">
      <div class="announcement-bar__content">
        {%- if has_blocks -%}
          {%- for block in section.blocks -%}
            <span class="announcement-bar__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
              <span class="announcement-bar__separator" aria-hidden="true">{{ section.settings.separator }}</span>
            </span>
          {%- endfor -%}
        {%- else -%}
          <span class="announcement-bar__item">
            {%- if section.settings.link != blank -%}
              <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
            {%- else -%}
              {{ section.settings.text }}
            {%- endif -%}
            <span class="announcement-bar__separator" aria-hidden="true">{{ section.settings.separator }}</span>
          </span>
        {%- endif -%}
      </div>

      <div class="announcement-bar__content" aria-hidden="true">
        {%- if has_blocks -%}
          {%- for block in section.blocks -%}
            <span class="announcement-bar__item">
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
              <span class="announcement-bar__separator">{{ section.settings.separator }}</span>
            </span>
          {%- endfor -%}
        {%- else -%}
          <span class="announcement-bar__item">
            {%- if section.settings.link != blank -%}
              <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
            {%- else -%}
              {{ section.settings.text }}
            {%- endif -%}
            <span class="announcement-bar__separator">{{ section.settings.separator }}</span>
          </span>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "announcement-bar-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Fallback text",
      "default": "Free shipping on orders over ₹999 · Escape The Ordinary · New drops every week",
      "info": "Used when no announcement blocks are added"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Fallback link"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator between messages",
      "default": "✦"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Scroll speed",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over ₹999"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Free shipping on orders over ₹999"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Escape The Ordinary — New drops every week"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "₹999 Drop — Buy 3 For ₹999"
          }
        }
      ]
    }
  ]
}
{% endschema %}
