{%- liquid
  assign collection = collections[section.settings.collection] | default: product.collections.first
  assign products_to_show = section.settings.products_to_show | default: 4
-%}

{%- if collection != blank and collection.products.size > 1 -%}
  <section class="section-padding">
    <div class="page-width">
      <div class="section-header">
        <h2 class="section-header__title">{{ section.settings.title | default: 'products.related_products' | t }}</h2>
      </div>
      <div class="product-grid">
        {%- assign skip_product = product.handle -%}
        {%- assign count = 0 -%}
        {%- for related_product in collection.products -%}
          {%- if related_product.handle != skip_product and count < products_to_show -%}
            {% render 'product-card', card_product: related_product %}
            {%- assign count = count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "related-products-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Defaults to product's first collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    }
  ]
}
{% endschema %}
