<section class="section-padding">
  <div class="page-width">
    <div class="section-header">
      <h2 class="section-header__title">{{ section.settings.title | default: 'Customer Reviews' }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="section-header__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="reviews-grid">
      {%- for block in section.blocks -%}
        <div class="review-card" {{ block.shopify_attributes }}>
          <div class="review-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
            {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
          </div>
          {%- if block.settings.text != blank -%}
            <p class="review-card__text">"{{ block.settings.text }}"</p>
          {%- endif -%}
          {%- if block.settings.author != blank -%}
            <p class="review-card__author">— {{ block.settings.author }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer reviews",
  "tag": "section",
  "class": "customer-reviews-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What Our Community Says"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Real reviews from real streetwear heads"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "default": "Quality is insane for the price. The oversized tee fits perfectly."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "text": "Best streetwear brand in India. Fast delivery and premium quality.",
            "author": "Arjun K."
          }
        },
        {
          "type": "review",
          "settings": {
            "text": "The ₹999 drop is a steal. Already ordered twice!",
            "author": "Priya M."
          }
        },
        {
          "type": "review",
          "settings": {
            "text": "Jerseys are fire. Exactly like the photos. 10/10 would recommend.",
            "author": "Rohan S."
          }
        }
      ]
    }
  ]
}
{% endschema %}
