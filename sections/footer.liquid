<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <p class="site-footer__brand-title">Escape Clothing 👣</p>
        <p class="site-footer__tagline">{{ settings.brand_tagline }}</p>
        {% render 'social-links' %}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="site-footer__heading">{{ block.settings.heading }}</p>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                {%- for link in block.settings.menu.links -%}
                  <a href="{{ link.url }}" class="site-footer__link">{{ link.title }}</a>
                {%- endfor -%}
              {%- endif -%}
            </div>
          {%- when 'text' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="site-footer__heading">{{ block.settings.heading }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="site-footer__link">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      <p>{{ 'footer.copyright' | t: year: 'now' | date: '%Y' }}</p>
      <p>{{ 'footer.payment_methods' | t }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "support@escapeclothing.shop"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "menu",
        "settings": {
          "heading": "Shop",
          "menu": "footer"
        }
      },
      {
        "type": "menu",
        "settings": {
          "heading": "Collections",
          "menu": "footer"
        }
      },
      {
        "type": "text",
        "settings": {
          "heading": "Contact",
          "text": "support@escapeclothing.shop"
        }
      }
    ]
  }
}
{% endschema %}
