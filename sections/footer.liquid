<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid site-footer__grid--5">
      <div class="site-footer__brand">
        {% render 'logo', class: 'site-footer__logo', logo_width: 110 %}
        <p class="site-footer__about">{{ section.settings.about_text | default: 'Escape Clothing 👣 — Premium streetwear for Gen-Z. Escape The Ordinary with curated fits, affordable drops, and fast PAN India shipping.' }}</p>
        {% render 'payment-icons' %}
      </div>

      <div class="site-footer__col">
        <p class="site-footer__heading">{{ section.settings.quick_links_title | default: 'Quick Links' }}</p>
        <a href="{{ routes.root_url }}" class="site-footer__link">Home</a>
        <a href="{{ routes.all_products_collection_url }}" class="site-footer__link">Shop All</a>
        <a href="{{ collections['new-arrivals'].url | default: routes.all_products_collection_url }}" class="site-footer__link">New Arrivals</a>
        <a href="{{ pages['contact'].url | default: '/pages/contact' }}" class="site-footer__link">Contact</a>
      </div>

      <div class="site-footer__col">
        <p class="site-footer__heading">{{ section.settings.support_title | default: 'Customer Support' }}</p>
        <a href="{{ pages['faq'].url | default: '/pages/faq' }}" class="site-footer__link">FAQ</a>
        <a href="{{ pages['shipping-policy'].url | default: '/pages/shipping-policy' }}" class="site-footer__link">Shipping Policy</a>
        <a href="{{ pages['refund-policy'].url | default: '/pages/refund-policy' }}" class="site-footer__link">Refund Policy</a>
        <a href="{{ pages['return-policy'].url | default: '/pages/return-policy' }}" class="site-footer__link">Return Policy</a>
        <a href="{{ pages['privacy-policy'].url | default: '/pages/privacy-policy' }}" class="site-footer__link">Privacy Policy</a>
        <a href="{{ pages['terms-and-conditions'].url | default: '/pages/terms-and-conditions' }}" class="site-footer__link">Terms & Conditions</a>
      </div>

      <div class="site-footer__col">
        <p class="site-footer__heading">{{ section.settings.contact_title | default: 'Contact Information' }}</p>
        {%- if section.settings.phone != blank -%}<a href="tel:{{ section.settings.phone }}" class="site-footer__link">📞 {{ section.settings.phone }}</a>{%- endif -%}
        {%- if section.settings.whatsapp != blank -%}<a href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' }}" class="site-footer__link" target="_blank" rel="noopener">💬 WhatsApp</a>{%- endif -%}
        {%- if section.settings.email != blank -%}<a href="mailto:{{ section.settings.email }}" class="site-footer__link">✉️ {{ section.settings.email }}</a>{%- endif -%}
        {%- if section.settings.location != blank -%}<p class="site-footer__link">📍 {{ section.settings.location }}</p>{%- endif -%}
        <a href="{{ pages['track-order'].url | default: '/pages/track-order' }}" class="site-footer__link">Track Order</a>
      </div>

      <div class="site-footer__col">
        <p class="site-footer__heading">{{ section.settings.social_title | default: 'Follow Us' }}</p>
        {% render 'social-links' %}
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>{{ 'footer.copyright' | t: year: 'now' | date: '%Y' }}</p>
      <p>Secure payments via Cashfree · UPI · Cards · COD</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "settings": [
    { "type": "textarea", "id": "about_text", "label": "About text" },
    { "type": "text", "id": "quick_links_title", "label": "Quick links heading", "default": "Quick Links" },
    { "type": "text", "id": "support_title", "label": "Support heading", "default": "Customer Support" },
    { "type": "text", "id": "contact_title", "label": "Contact heading", "default": "Contact Information" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+91 98765 43210" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number", "default": "919876543210" },
    { "type": "text", "id": "email", "label": "Email", "default": "support@escapeclothing.shop" },
    { "type": "text", "id": "location", "label": "Store location", "default": "India" },
    { "type": "text", "id": "social_title", "label": "Social heading", "default": "Follow Us" }
  ]
}
{% endschema %}
