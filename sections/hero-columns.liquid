<section class="hero-columns" data-section-id="{{ section.id }}" data-section-type="hero-columns">
  
  <!-- Column 1 -->
  <div class="hero-column">
    <div class="hero-column__media">
      {%- if section.settings.image_1 != blank -%}
        <img src="{{ section.settings.image_1 | image_url: width: 800 }}" class="hero-column__img" alt="{{ section.settings.title_1 | escape }}" loading="eager">
      {%- else -%}
        <img src="https://images.unsplash.com/photo-1509631179647-0177331693ae?q=80&w=800&auto=format&fit=crop" class="hero-column__img" alt="The Never Run-Out Collection" loading="eager">
      {%- endif -%}
      <div class="hero-column__overlay"></div>
    </div>
    <div class="hero-column__content">
      <h2 class="hero-column__title">{{ section.settings.title_1 }}</h2>
      <a href="{{ section.settings.link_1 | default: '#shop-all' }}" class="hero-column__btn">
        {{ section.settings.btn_label_1 | default: 'Shop The Drop' }}
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>

  <!-- Column 2 -->
  <div class="hero-column">
    <div class="hero-column__media">
      {%- if section.settings.image_2 != blank -%}
        <img src="{{ section.settings.image_2 | image_url: width: 800 }}" class="hero-column__img" alt="Gifting Collection" loading="eager">
      {%- else -%}
        <img src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?q=80&w=800&auto=format&fit=crop" class="hero-column__img" alt="Gifting Collection" loading="eager">
      {%- endif -%}
      <div class="hero-column__overlay"></div>
    </div>
    
    <!-- Retro Reminder card popup overlay -->
    <div class="reminder-container">
      <div class="reminder-card">
        <div class="reminder-card__header">
          <span class="reminder-card__header-icon">+</span>
          <span class="reminder-card__header-title">{{ section.settings.reminder_title | default: 'Reminder' }}</span>
          <span class="reminder-card__header-icon">≡</span>
        </div>
        <div class="reminder-card__body">
          <p class="reminder-card__text">{{ section.settings.reminder_text }}</p>
        </div>
        <button type="button" class="reminder-card__btn" id="gift-now-btn">{{ section.settings.reminder_btn_label | default: 'GIFT NOW' }}</button>
      </div>
    </div>
  </div>

  <!-- Column 3 -->
  <div class="hero-column">
    <div class="hero-column__media">
      {%- if section.settings.image_3 != blank -%}
        <img src="{{ section.settings.image_3 | image_url: width: 800 }}" class="hero-column__img" alt="{{ section.settings.title_3 | escape }}" loading="eager">
      {%- else -%}
        <img src="https://images.unsplash.com/photo-1617137968427-85924c800a22?q=80&w=800&auto=format&fit=crop" class="hero-column__img" alt="Trousers Collection" loading="eager">
      {%- endif -%}
      <div class="hero-column__overlay"></div>
    </div>
    <div class="hero-column__content">
      <h2 class="hero-column__title">{{ section.settings.title_3 }}</h2>
      <a href="{{ section.settings.link_3 | default: '#shop-all' }}" class="hero-column__btn">
        {{ section.settings.btn_label_3 | default: 'Explore Fits' }}
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>

</section>

{% schema %}
{
  "name": "3-Column Hero Grid",
  "class": "hero-columns-section",
  "settings": [
    { "type": "header", "content": "Column 1 Settings" },
    { "type": "image_picker", "id": "image_1", "label": "Column 1 Image" },
    { "type": "text", "id": "title_1", "label": "Column 1 Title", "default": "THE NEVER RUN-OUT COLLECTION" },
    { "type": "text", "id": "btn_label_1", "label": "Column 1 Button Label", "default": "Shop The Drop" },
    { "type": "url", "id": "link_1", "label": "Column 1 Button Link" },
    { "type": "header", "content": "Column 2 Settings" },
    { "type": "image_picker", "id": "image_2", "label": "Column 2 Image" },
    { "type": "text", "id": "reminder_title", "label": "Reminder Title", "default": "Reminder" },
    { "type": "text", "id": "reminder_text", "label": "Reminder Text", "default": "Father's Day is on 21 June and you're seeing this for a reason." },
    { "type": "text", "id": "reminder_btn_label", "label": "Reminder Button Label", "default": "GIFT NOW" },
    { "type": "header", "content": "Column 3 Settings" },
    { "type": "image_picker", "id": "image_3", "label": "Column 3 Image" },
    { "type": "text", "id": "title_3", "label": "Column 3 Title", "default": "TROUSERS & CARGOS" },
    { "type": "text", "id": "btn_label_3", "label": "Column 3 Button Label", "default": "Explore Fits" },
    { "type": "url", "id": "link_3", "label": "Column 3 Button Link" }
  ],
  "presets": [
    {
      "name": "3-Column Hero Grid"
    }
  ]
}
{% endschema %}
