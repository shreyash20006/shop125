<section class="categories-section section-reveal">
  <div class="page-width">
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="section-header section-header--split">
        <div>
          {%- if section.settings.label != blank -%}
            <p class="section-label">{{ section.settings.label }}</p>
          {%- else -%}
            <p class="section-label">Collections</p>
          {%- endif -%}
          <h2 class="section-title">{{ section.settings.title | default: 'Shop by Category' }}</h2>
        </div>
        {%- if section.settings.subtitle != blank -%}
          <p class="section-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cat-grid cat-grid--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="cat-card" {{ block.shopify_attributes }}>
          <div class="cat-card__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag: loading: 'lazy', class: 'cat-card__img', widths: '400,600,800', sizes: '(min-width: 990px) 25vw, 50vw'
              }}
            {%- else -%}
              {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'cat-card__img cat-card__img--placeholder' }}
            {%- endif -%}
            <div class="cat-card__overlay"></div>
          </div>
          <div class="cat-card__info">
            <p class="cat-card__title">{{ block.settings.title | default: 'Category' }}</p>
            {%- if block.settings.subtitle != blank -%}
              <p class="cat-card__sub">{{ block.settings.subtitle }}</p>
            {%- endif -%}
            <span class="cat-card__cta">Shop Now <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured categories",
  "tag": "section",
  "class": "featured-categories-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Curated streetwear for every vibe"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Jerseys", "subtitle": "Korean · NBA · Football" } },
        { "type": "category", "settings": { "title": "Oversized Tees", "subtitle": "Boxy · Graphic · Street" } },
        { "type": "category", "settings": { "title": "Shirts", "subtitle": "Zara Style · Corduroy" } },
        { "type": "category", "settings": { "title": "Bottoms", "subtitle": "Cargos · Denim · Track" } }
      ]
    }
  ]
}
{% endschema %}
