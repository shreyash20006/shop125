<section class="section-padding">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="section-header">
        <h2 class="section-header__title">{{ section.settings.title }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="section-header__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="category-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="category-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag: loading: 'lazy', class: 'category-card__image', widths: '400,600,800', sizes: '(min-width: 750px) 25vw, 50vw'
            }}
          {%- else -%}
            {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'category-card__image' }}
          {%- endif -%}
          <div class="category-card__overlay">
            <div>
              <p class="category-card__title">{{ block.settings.title }}</p>
              {%- if block.settings.subtitle != blank -%}
                <p class="category-card__count">{{ block.settings.subtitle }}</p>
              {%- endif -%}
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured categories",
  "tag": "section",
  "class": "featured-categories-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Curated streetwear for every vibe"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Jerseys" } },
        { "type": "category", "settings": { "title": "Oversized Tees" } },
        { "type": "category", "settings": { "title": "Shirts" } },
        { "type": "category", "settings": { "title": "Bottoms" } }
      ]
    }
  ]
}
{% endschema %}
