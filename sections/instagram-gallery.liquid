<section class="instagram-section section-reveal">
  <div class="page-width">
    <div class="section-header">
      <p class="section-label">{{ section.settings.label | default: 'Instagram' }}</p>
      <h2 class="section-title">{{ section.settings.title | default: '@escapeclothing' }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="insta-grid">
    {%- for block in section.blocks -%}
      <a
        href="{{ block.settings.link | default: settings.social_instagram | default: '#' }}"
        class="insta-grid__item"
        target="_blank"
        rel="noopener noreferrer"
        {{ block.shopify_attributes }}
        aria-label="Instagram post {{ forloop.index }}"
      >
        <div class="insta-grid__media">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 600
              | image_tag: loading: 'lazy', widths: '300,600', sizes: '(min-width: 990px) 16vw, 33vw'
            }}
          {%- else -%}
            {{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag }}
          {%- endif -%}
          <div class="insta-grid__overlay">
            <svg class="insta-grid__icon" width="24" height="24" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="5" stroke="white" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="white" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="white"/></svg>
          </div>
        </div>
      </a>
    {%- endfor -%}
  </div>

  {%- if section.settings.instagram_handle != blank -%}
    <div style="text-align:center; margin-top: 2.5rem;">
      <a href="https://instagram.com/{{ section.settings.instagram_handle | remove: '@' }}" class="btn btn--secondary" target="_blank" rel="noopener noreferrer">
        Follow @{{ section.settings.instagram_handle | remove: '@' }}
      </a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Instagram gallery",
  "tag": "section",
  "class": "instagram-gallery-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "label", "label": "Section label", "default": "Instagram" },
    { "type": "text", "id": "title", "label": "Heading", "default": "@escapeclothing" },
    { "type": "text", "id": "subtitle", "label": "Subheading", "default": "Tag us in your fits for a chance to be featured" },
    { "type": "text", "id": "instagram_handle", "label": "Instagram handle", "default": "escapeclothing" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram gallery",
      "blocks": [
        { "type": "image" }, { "type": "image" }, { "type": "image" },
        { "type": "image" }, { "type": "image" }, { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
