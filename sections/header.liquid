<header class="site-header" data-sticky-header data-section-id="{{ section.id }}" data-section-type="header">
  <div class="page-width">
    <div class="site-header__inner" style="grid-template-columns: 1fr auto 1fr;">
      
      <!-- Left menu & Pincode check -->
      <div class="site-header__menu-and-pincode">
        <button type="button" class="site-header__icon site-header__menu-toggle" data-mobile-menu-toggle aria-label="{{ 'accessibility.open_menu' | t }}" style="display: flex; width: auto; height: auto; padding: 4px;">
          {% render 'icon-menu' %}
        </button>
        <div class="pincode-trigger" id="pincode-trigger-btn">
          📍 Deliver to: <span id="current-pincode-display">Select Pincode</span>
        </div>
      </div>

      <!-- Centered Logo -->
      <div class="site-header__logo-wrapper" style="justify-self: center;">
        {% render 'logo', class: 'site-header__logo', logo_width: settings.logo_width %}
      </div>

      <!-- Right side: Search Box and Action Icons -->
      <div class="site-header__icons" style="justify-self: end;">
        <!-- Snitch-style Search input inside Header (Desktop only) -->
        <div class="snitch-search-wrapper">
          <form action="{{ routes.search_url }}" method="get" role="search" class="snitch-search-form" style="display:flex; width:100%; align-items:center;">
            <span class="snitch-search-icon">
              {% render 'icon-search' %}
            </span>
            <input type="search" name="q" placeholder='Search "OVERSHIRT"' class="snitch-search-input" id="desktop-search-input" autocomplete="off">
            <input type="hidden" name="type" value="product">
          </form>
        </div>

        <!-- Mobile Search Icon Toggle -->
        <button type="button" class="site-header__icon site-header__search-toggle" data-search-open aria-label="{{ 'general.search' | t }}">
          {% render 'icon-search' %}
        </button>
        
        <a href="{{ routes.account_url }}" class="site-header__icon" aria-label="{{ 'header.account' | t }}">{% render 'icon-account' %}</a>
        <a href="{{ pages['wishlist'].url | default: '/pages/wishlist' }}" class="site-header__icon" data-wishlist-link aria-label="{{ 'header.wishlist' | t }}">{% render 'icon-wishlist' %}</a>
        <a href="{{ routes.cart_url }}" class="site-header__icon" data-cart-open aria-label="{{ 'header.cart' | t }}">
          {% render 'icon-cart' %}
          <span class="site-header__cart-count" data-cart-count{% if cart.item_count == 0 %} style="display:none"{% endif %}>{{ cart.item_count }}</span>
        </a>
      </div>

    </div>
  </div>

  <div class="mobile-menu" data-mobile-menu aria-hidden="true">
    <div class="mobile-menu__overlay" data-mobile-menu-close></div>
    <div class="mobile-menu__panel">
      <div class="mobile-menu__header">
        {% render 'logo', class: 'mobile-menu__logo', logo_width: 100 %}
        <button type="button" data-mobile-menu-close aria-label="{{ 'accessibility.close_menu' | t }}">{% render 'icon-close' %}</button>
      </div>
      <form action="{{ routes.search_url }}" method="get" role="search" class="mobile-menu__search">
        <input type="search" name="q" placeholder="{{ 'general.search_placeholder' | t }}" class="mobile-menu__search-input">
        <input type="hidden" name="type" value="product">
      </form>
      <nav aria-label="Mobile navigation">
        <a href="{{ routes.root_url }}" class="mobile-menu__nav-link">Home</a>
        {%- for link in section.settings.menu.links -%}
          {%- unless link.title == 'Home' -%}
            <a href="{{ link.url }}" class="mobile-menu__nav-link">{{ link.title }}</a>
            {%- for child_link in link.links -%}
              <a href="{{ child_link.url }}" class="mobile-menu__sub-link">{{ child_link.title }}</a>
            {%- endfor -%}
          {%- endunless -%}
        {%- endfor -%}
      </nav>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" }
  ]
}
{% endschema %}
