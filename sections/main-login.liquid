<div class="page-content page-width customer-page">
  <h1 class="page-content__title">Login</h1>
  {% form 'customer_login' %}
    {{ form.errors | default_errors }}
    <div class="contact-form">
      <input type="email" name="customer[email]" placeholder="Email" required>
      <input type="password" name="customer[password]" placeholder="Password" required>
      <button type="submit" class="btn btn--primary">Sign In</button>
    </div>
  {% endform %}
  <p style="margin-top:1.5rem;text-align:center;"><a href="{{ routes.account_register_url }}">Create account</a></p>
</div>
{% schema %}{ "name": "Login", "settings": [] }{% endschema %}
