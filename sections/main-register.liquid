<div class="page-content page-width customer-page">
  <h1 class="page-content__title">Create Account</h1>
  {% form 'create_customer' %}
    {{ form.errors | default_errors }}
    <div class="contact-form">
      <input type="text" name="customer[first_name]" placeholder="First name" required>
      <input type="text" name="customer[last_name]" placeholder="Last name">
      <input type="email" name="customer[email]" placeholder="Email" required>
      <input type="password" name="customer[password]" placeholder="Password" required>
      <button type="submit" class="btn btn--primary">Create Account</button>
    </div>
  {% endform %}
  <p style="margin-top:1.5rem;text-align:center;"><a href="{{ routes.account_login_url }}">Already have an account?</a></p>
</div>
{% schema %}{ "name": "Register", "settings": [] }{% endschema %}
