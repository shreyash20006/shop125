<div class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">{{ 'cart.title' | t }} (<span data-cart-count-text>{{ cart.item_count }}</span>)</h2>
      <button type="button" data-cart-close aria-label="{{ 'general.close' | t }}">
        {% render 'icon-close' %}
      </button>
    </div>

    <div data-cart-drawer-content>
      {% render 'cart-drawer-content' %}
    </div>

    {%- assign rec_collection = collections[section.settings.recommended_collection] | default: collections.all -%}
    {%- if rec_collection.products.size > 0 -%}
      <div class="cart-drawer__recommended">
        <p class="cart-drawer__recommended-title">{{ 'cart.recommended' | t }}</p>
        <div class="cart-drawer__recommended-grid">
          {%- for product in rec_collection.products limit: 2 -%}
            <a href="{{ product.url }}" class="cart-drawer__rec-item">
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', class: 'cart-drawer__rec-image' }}
              {%- endif -%}
              <span>{{ product.title | truncate: 30 }}</span>
              <span>{{ product.price | money }}</span>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "tag": "section",
  "class": "cart-drawer-section",
  "settings": [
    {
      "type": "collection",
      "id": "recommended_collection",
      "label": "Recommended products collection"
    }
  ]
}
{% endschema %}
