<div class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">{{ 'cart.title' | t }} (<span data-cart-count-text>{{ cart.item_count }}</span>)</h2>
      <button type="button" data-cart-close aria-label="{{ 'general.close' | t }}">
        {% render 'icon-close' %}
      </button>
    </div>

    <div data-cart-drawer-content>
      {% render 'cart-drawer-content' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "tag": "section",
  "class": "cart-drawer-section",
  "settings": [
    {
      "type": "collection",
      "id": "recommended_collection",
      "label": "Recommended products collection"
    }
  ]
}
{% endschema %}
